<component type="desktop-application">
  <id>io.github.nexus_svk.Coreglow</id>
  <name>Coreglow</name>
  <summary>Lighting effects, profiles and fan control for Corsair Commander controllers</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Drives the Corsair iCUE Commander CORE XT (and, experimentally, the Commander CORE of the
      ELITE CAPELLIX and ELITE LCD coolers) on Linux without iCUE: lighting effects, per-part
      lighting, fan curves, profiles that switch automatically, and night dimming.
    </p>
  </description>
