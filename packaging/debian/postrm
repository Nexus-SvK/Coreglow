#!/bin/sh
set -e
if [ "$1" = "purge" ] && command -v deb-systemd-helper >/dev/null; then
    deb-systemd-helper --user purge coreglowd.service || true
fi
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v udevadm >/dev/null; then
        udevadm control --reload-rules || true
    fi
fi
exit 0
